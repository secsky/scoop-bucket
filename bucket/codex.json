  "pre_install": [
    "$msix = Get-ChildItem -LiteralPath $dir -Filter '*.Msix' -File | Select-Object -First 1",
    "if ($msix) { Expand-7zipArchive $msix.FullName $dir -Removal }",
    "# Decode percent-encoded MSIX ZIP paths (e.g. %40scope -> @scope) so Node/Computer Use modules resolve.",
    "Get-ChildItem -LiteralPath $dir -Recurse -Force | Where-Object { $_.Name -match '%[0-9A-Fa-f]{2}' } | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object {",
    "    $decoded = [System.Uri]::UnescapeDataString($_.Name)",
    "    if ($decoded -ne $_.Name -and $decoded -notmatch '[/\\\\]' -and $decoded.IndexOf([char]0) -eq -1) {",
    "        $dest = Join-Path (Split-Path -Parent $_.FullName) $decoded",
    "        if (-not (Test-Path -LiteralPath $dest)) {",
    "            Rename-Item -LiteralPath $_.FullName -NewName $decoded -Force",
    "        }",
    "    }",
    "}",
    "$manifestPath = Join-Path $dir 'AppxManifest.xml'",
    "$exeFull = $null",
    "if (Test-Path -LiteralPath $manifestPath) {",
    "    [xml]$appx = Get-Content -LiteralPath $manifestPath -Raw",
    "    $ns = New-Object System.Xml.XmlNamespaceManager($appx.NameTable)",
    "    $ns.AddNamespace('m', $appx.DocumentElement.NamespaceURI)",
    "    $appNode = $appx.SelectSingleNode('//m:Applications/m:Application[@Executable]', $ns)",
    "    if ($appNode) {",
    "        $candidate = Join-Path $dir ($appNode.GetAttribute('Executable') -replace '/', '\\')",
    "        if (Test-Path -LiteralPath $candidate -PathType Leaf) { $exeFull = $candidate }",
    "    }",
    "}",
    "if (-not $exeFull) {",
    "    foreach ($name in @('ChatGPT.exe', 'Codex.exe')) {",
    "        $found = Get-ChildItem -LiteralPath $dir -Filter $name -File -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
    "        if ($found) { $exeFull = $found.FullName; break }",
    "    }",
    "}",
    "if (-not $exeFull) { throw 'Could not locate Codex application executable inside extracted MSIX.' }",
    "$exeDir = Split-Path -Parent $exeFull",
    "$exeName = Split-Path -Leaf $exeFull",
    "$appDir = Join-Path $dir 'app'",
    "if ($exeDir -eq $dir) {",
    "    New-Item -ItemType Directory -Path $appDir -Force | Out-Null",
    "    $skip = @('app', 'AppxManifest.xml', 'AppxBlockMap.xml', 'AppxSignature.p7x', '[Content_Types].xml', 'AppxMetadata')",
    "    Get-ChildItem -LiteralPath $dir -Force | Where-Object { $skip -notcontains $_.Name } | Move-Item -Destination $appDir -Force",
    "} elseif ($exeDir -ne $appDir) {",
    "    if (Test-Path -LiteralPath $appDir) { Remove-Item -LiteralPath $appDir -Recurse -Force }",
    "    Move-Item -LiteralPath $exeDir -Destination $appDir -Force",
    "}",
    "Remove-Item -LiteralPath (Join-Path $dir 'AppxBlockMap.xml'), (Join-Path $dir 'AppxSignature.p7x'), (Join-Path $dir '[Content_Types].xml'), (Join-Path $dir 'AppxMetadata') -Recurse -Force -ErrorAction SilentlyContinue",
    "$utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
    "[System.IO.File]::WriteAllText((Join-Path $dir 'codex-portable-launcher.txt'), \"app\\$exeName\", $utf8NoBom)",
    "$csc = Get-ChildItem \"$env:WINDIR\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe\", \"$env:WINDIR\\Microsoft.NET\\Framework\\v4.0.30319\\csc.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty FullName",
    "if (-not $csc) { throw 'Could not find .NET Framework csc.exe to build portable Codex launcher.' }",
    "$launcherCs = @'",
    "using System;",
    "using System.Diagnostics;",
    "using System.IO;",
    "using System.Reflection;",
    "using System.Text;",
    "using System.Windows.Forms;",
    "internal static class Program {",
    "    private const string LaunchTargetFile = \"codex-portable-launcher.txt\";",
    "    private const string ProtocolPrefix = \"--codex-protocol-url\";",
    "    [STAThread]",
    "    private static int Main(string[] args) {",
    "        try {",
    "            string ownExe = Assembly.GetExecutingAssembly().Location;",
    "            string root = Path.GetDirectoryName(ownExe);",
    "            string target = File.ReadAllText(Path.Combine(root, LaunchTargetFile), Encoding.UTF8).Trim();",
    "            if (string.IsNullOrEmpty(target) || Path.IsPathRooted(target) || target.Contains(\"..\")) throw new InvalidOperationException(\"Invalid portable launch target.\");",
    "            string exe = Path.GetFullPath(Path.Combine(root, target));",
    "            if (string.Equals(exe, Path.GetFullPath(ownExe), StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException(\"Portable launcher cannot launch itself.\");",
    "            if (!File.Exists(exe)) throw new FileNotFoundException(\"Portable app executable not found.\", exe);",
    "            string appDir = Path.GetDirectoryName(exe);",
    "            var psi = new ProcessStartInfo { FileName = exe, WorkingDirectory = appDir, UseShellExecute = false, Arguments = BuildArguments(args) };",
    "            psi.EnvironmentVariables.Remove(\"CODEX_WINDOWS_REGISTERED_CORE\");",
    "            psi.EnvironmentVariables[\"CODEX_SPARKLE_ENABLED\"] = \"false\";",
    "            if (string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(\"CODEX_CLI_PATH\"))) {",
    "                string cli = Path.Combine(appDir, \"resources\", \"codex.exe\");",
    "                if (!File.Exists(cli)) cli = Path.Combine(appDir, \"resources\", \"bin\", \"codex.exe\");",
    "                if (File.Exists(cli)) psi.EnvironmentVariables[\"CODEX_CLI_PATH\"] = cli;",
    "            }",
    "            Process.Start(psi);",
    "            return 0;",
    "        } catch (Exception ex) {",
    "            MessageBox.Show(\"Codex could not start.\\n\\n\" + ex.Message, \"Codex portable launcher\", MessageBoxButtons.OK, MessageBoxIcon.Error);",
    "            return 1;",
    "        }",
    "    }",
    "    private static string BuildArguments(string[] args) {",
    "        if (args == null || args.Length == 0) return string.Empty;",
    "        if (args[0] == ProtocolPrefix) {",
    "            if (args.Length != 2 || string.IsNullOrEmpty(args[1]) || args[1].Length <= 6 || !args[1].StartsWith(\"codex:\", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException(\"Invalid Codex protocol URL.\");",
    "            foreach (char ch in args[1]) { if (char.IsControl(ch) || char.IsWhiteSpace(ch) || ch == '\"' || ch == '\\\\') throw new InvalidOperationException(\"Invalid Codex protocol URL.\"); }",
    "            return QuoteArg(args[1]);",
    "        }",
    "        var sb = new StringBuilder();",
    "        for (int i = 0; i < args.Length; i++) { if (i > 0) sb.Append(' '); sb.Append(QuoteArg(args[i])); }",
    "        return sb.ToString();",
    "    }",
    "    private static string QuoteArg(string arg) {",
    "        if (arg.Length > 0 && arg.IndexOfAny(new[] { ' ', '\\t', '\\n', '\\v', '\"' }) == -1) return arg;",
    "        var sb = new StringBuilder(); sb.Append('\"'); int backslashes = 0;",
    "        foreach (char ch in arg) {",
    "            if (ch == '\\\\') { backslashes++; }",
    "            else if (ch == '\"') { sb.Append('\\\\', backslashes * 2 + 1); sb.Append('\"'); backslashes = 0; }",
    "            else { if (backslashes > 0) { sb.Append('\\\\', backslashes); backslashes = 0; } sb.Append(ch); }",
    "        }",
    "        if (backslashes > 0) sb.Append('\\\\', backslashes * 2);",
    "        sb.Append('\"'); return sb.ToString();",
    "    }",
    "}",
    "'@",
    "$csPath = Join-Path $dir 'CodexLauncher.cs'",
    "$exeOut = Join-Path $dir 'Codex.exe'",
    "[System.IO.File]::WriteAllText($csPath, $launcherCs, $utf8NoBom)",
    "& $csc /nologo /optimize+ /target:winexe \"/out:$exeOut\" /reference:System.Windows.Forms.dll \"$csPath\"",
    "if ($LASTEXITCODE -ne 0) { throw \"csc.exe failed with exit code $LASTEXITCODE\" }",
    "Remove-Item -LiteralPath $csPath -Force -ErrorAction SilentlyContinue"
  ],
  "post_install": [
    "$target = (Get-Content -LiteralPath (Join-Path $dir 'codex-portable-launcher.txt') -Raw).Trim()",
    "$appExe = Join-Path $dir $target",
    "$lnk = Join-Path ([Environment]::GetFolderPath('Programs')) 'Scoop Apps\\Codex.lnk'",
    "if ((Test-Path -LiteralPath $lnk) -and (Test-Path -LiteralPath $appExe)) {",
    "    $ws = New-Object -ComObject WScript.Shell",
    "    $sc = $ws.CreateShortcut($lnk)",
    "    $sc.IconLocation = \"$appExe,0\"",
    "    $sc.Save()",
    "}",
    "$protoKey = 'HKCU:\\Software\\Classes\\codex'",
    "$owned = (-not (Test-Path -LiteralPath $protoKey)) -or ((Get-ItemProperty -LiteralPath $protoKey -Name 'ScoopManaged' -ErrorAction SilentlyContinue).ScoopManaged -eq 1)",
    "if ($owned) {",
    "    New-Item -Path $protoKey -Force | Out-Null",
    "    Set-ItemProperty -LiteralPath $protoKey -Name '(Default)' -Value 'URL:Codex Protocol'",
    "    Set-ItemProperty -LiteralPath $protoKey -Name 'URL Protocol' -Value ''",
    "    Set-ItemProperty -LiteralPath $protoKey -Name 'ScoopManaged' -Value 1 -Type DWord",
    "    New-Item -Path \"$protoKey\\DefaultIcon\" -Force | Out-Null",
    "    Set-ItemProperty -LiteralPath \"$protoKey\\DefaultIcon\" -Name '(Default)' -Value \"`\"$appExe`\",0\"",
    "    New-Item -Path \"$protoKey\\shell\\open\\command\" -Force | Out-Null",
    "    Set-ItemProperty -LiteralPath \"$protoKey\\shell\\open\\command\" -Name '(Default)' -Value \"`\"$(Join-Path $dir 'Codex.exe')`\" --codex-protocol-url `\"%1`\"\"",
    "}"
  ],
  "pre_uninstall": [
    "$protoKey = 'HKCU:\\Software\\Classes\\codex'",
    "if ((Get-ItemProperty -LiteralPath $protoKey -Name 'ScoopManaged' -ErrorAction SilentlyContinue).ScoopManaged -eq 1) {",
    "    Remove-Item -LiteralPath $protoKey -Recurse -Force -ErrorAction SilentlyContinue",
    "}"
  ],
